{
  "name": "ligo.afk",
  "version": "5.1.0",
  "description": "ligo Browser Extension",
  "type": "module",
  "main": "js/script.js",
  "scripts": {
    "start": "node scripts/build.js --watch",
    "start:fox": "web-ext run",
    "start:macos": "web-ext run -p default --firefox=/Applications/FirefoxDeveloperEdition.app/Contents/MacOS/firefox-bin",
    "lint": "eslint 'src/**/*.js'",
    "lint:fix": "eslint --fix 'src/**/*.js'",
    "lint:format": "prettier --write 'src/**/*.js'",
    "test": "eslint 'src/**/*.js' && web-ext lint -s dist",
    "build": "node scripts/build.js",
    "build:chrome": "crx pack dist -o build/ligo.crx && web-ext build -s dist -a build",
    "build:fox": "web-ext build -s dist --overwrite-dest",
    "prepare": "husky"
  },
  "repository": "git+https://github.com/Arlefreak/ligo_extension.git",
  "keywords": [
    "extension",
    "afk",
    "ligo",
    "link"
  ],
  "author": "AFK",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/afk-mario/ligo_extension/issues"
  },
  "homepage": "https://github.com/afk-mario/ligo_extension",
  "lint-staged": {
    "src/**/*.{js,json,css}": [
      "prettier --single-quote --trailing-comma es5 --write",
      "git add"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.4.20",
    "crx": "^5.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "web-ext": "^10.5.0"
  },
  "dependencies": {
    "choo": "^7.1.0"
  },
  "webExt": {
    "verbose": true,
    "sourceDir": "dist",
    "build": {
      "overwriteDest": true
    },
    "run": {
      "firefox": "firefox-developer-edition",
      "browserConsole": true,
      "startUrl": [
        "about:debugging",
        "https://melanie-richards.com/blog/css-grid-sticky"
      ]
    }
  }
}
